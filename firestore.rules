rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'admin';
    }

    match /users/{userId} {
      allow create: if isVerified() && request.auth.uid == userId;
      allow read: if isVerified() && request.auth.uid == userId;
      allow update: if isVerified()
        && (
          request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'email',
          'photoURL',
          'bio',
          'level',
          'school',
          'gender',
          'subjects',
          'filterFeedByInterests',
          'phone',
          'youtube',
          'socials-youtube',
          'socials-phone',
          'socials-email',
          'socials-whatsapp',
          'socials-whatsapp-channel',
          'marked-as-read',
          'hidden-pages',
          'saved-pages',
          'saved-books',
          'saved-lessons',
          'saved-posts'
          ]
        )
        || (isVerified() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'admin')
        );
      allow delete: if false;

      match /assistant_conversations/{conversationId} {
        allow read, write: if isVerified() && request.auth.uid == userId;
      }
    }

    match /teachers/{teacherId} {
      allow create: if isVerified()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'admin';
      allow read: if isVerified() && request.auth.uid == teacherId;
      allow update: if isVerified() && (
        request.auth.uid == teacherId
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'admin'
      ) && request.resource.data.type == 'teacher';
      allow delete: if false;
    }

    match /teacherApplications/{applicationId} {
      allow create: if isVerified() && request.auth.uid == applicationId;
      allow read: if isVerified() && (
        request.auth.uid == applicationId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'admin'
      );
      allow update: if isVerified() && (
        (
          request.auth.uid == applicationId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'applicantId', 'name', 'email', 'school', 'subjects',
            'filterFeedByInterests', 'phone', 'youtube', 'socials-youtube',
            'socials-phone', 'socials-email', 'socials-whatsapp',
            'socials-whatsapp-channel', 'updatedAt'
          ])
        ) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'admin'
      );
      allow delete: if false;
    }

    match /adminNotifications/{notificationId} {
      allow read, update: if isVerified() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'admin';
      allow create: if false;
      allow delete: if false;
    }

    match /activityEvents/{eventId} {
      allow create: if isVerified()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'userName', 'userEmail', 'type', 'resourceId', 'openedAt'
        ]);
      allow read: if isVerified() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'admin';
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if isVerified()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'username', 'userEmail', 'reasons', 'details', 'item',
          'createdAt', 'status'
        ])
        && request.resource.data.status == 'new';
      allow read, update: if isVerified()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'admin';
      allow delete: if false;
    }

    match /teacherApplicationAudit/{auditId} {
      allow read: if isVerified() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'admin';
      allow write: if false;
    }

    match /books/{bookId} {
      allow create: if isVerified()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'title',
          'author',
          'owner',
          'description',
          'cover',
          'updatedAt'
        ]);
      allow read: if isVerified();
      allow update: if isVerified()
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner;
      allow delete: if isVerified() && (resource.data.owner == request.auth.uid || isAdmin());
    }

    match /pages/{pageId} {
      allow read: if isVerified();
      allow create: if isVerified() && request.resource.data.owner == request.auth.uid;
      allow update: if isVerified() && (resource.data.owner == request.auth.uid || isAdmin());
      allow delete: if isVerified() && (resource.data.owner == request.auth.uid || isAdmin());
    }

    match /pastPaper/{paperId} {
      allow read: if isVerified();
      allow create: if isVerified() && request.resource.data.owner == request.auth.uid;
      allow update: if isVerified() && (resource.data.owner == request.auth.uid || isAdmin());
      allow delete: if isVerified() && (resource.data.owner == request.auth.uid || isAdmin());
    }

    match /trendingLessons/{lessonId} {
      allow read: if isVerified();
      allow create: if isVerified() && request.resource.data.owner == request.auth.uid;
      allow update: if isVerified() && (resource.data.owner == request.auth.uid || isAdmin());
      allow delete: if isVerified() && (resource.data.owner == request.auth.uid || isAdmin());
    }

    match /teacherPosts/{postId} {
      allow read: if isVerified();
      allow create: if isVerified() && request.resource.data.owner == request.auth.uid;
      allow update: if isVerified() && (resource.data.owner == request.auth.uid || isAdmin());
      allow delete: if isVerified() && (resource.data.owner == request.auth.uid || isAdmin());
    }

    match /config/{documentId} {
      allow read: if isVerified();
      allow write: if false;
    }

    match /ai assistant/{documentId} {
      allow read: if isVerified();
      allow write: if false;
    }

    match /ai knowledge/{documentId} {
      allow read: if isVerified();
      allow write: if false;
    }

    match /app/{documentId} {
      allow read: if isVerified();
      allow write: if false;
    }
  }
}
