{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "predeploy": ["node scripts/prepare-hosting.js"],
    "rewrites": [
      {
        "source": "/finishSignIn",
        "destination": "/index.html"
      },
      {
        "source": "/share/**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": { "rules": "firestore.rules" },
  "storage": { "rules": "storage.rules" },
  "functions": {
    "source": "functions",
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  }
}
