        "expo-notifications",
        {
          "color": "#006eff",
          "defaultChannel": "learning-reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DigiLearn uses your photos so you can choose a profile picture.",
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#006eff",
            "cropToolbarIconColor": "#ffffff",
            "cropToolbarActionTextColor": "#ffffff",
            "cropBackButtonIconColor": "#ffffff",
            "cropBackgroundColor": "#ffffff"
