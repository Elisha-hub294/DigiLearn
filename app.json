    "web": {
      "output": "static",
      "favicon": "./assets/images/main.png",
      "config": {
        "firebase": {
          "apiKey": "AIzaSyCKAYN1h2binUbKcJAZhcXZL8KQ_rBs21I",
          "authDomain": "digilearn-af86d.firebaseapp.com",
          "projectId": "digilearn-af86d",
