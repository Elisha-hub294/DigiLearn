{
  "expo": {
    "name": "OS platform",
    "slug": "os-platform",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/main.png",
    "scheme": "digilearn",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/main.png",
      "bundleIdentifier": "com.digilearn.app",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:digilearn-af86d.firebaseapp.com",
        "applinks:digilearn-af86d.firebaseapp.com"
      ]
    },
    "android": {
      "package": "com.osplatform.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "digilearn-af86d.firebaseapp.com",
              "pathPrefix": "/__/auth/links"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "digilearn-af86d.firebaseapp.com",
              "pathPrefix": "/share"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "digilearn-af86d.firebaseapp.com",
              "pathPrefix": "/__/auth/links"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "digilearn-af86d.firebaseapp.com",
              "pathPrefix": "/share"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/main.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/main.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/panda.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#006eff",
          "defaultChannel": "learning-reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OS platform uses your photos so you can choose a profile picture.",
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#006eff",
            "cropToolbarIconColor": "#ffffff",
            "cropToolbarActionTextColor": "#ffffff",
            "cropBackButtonIconColor": "#ffffff",
            "cropBackgroundColor": "#ffffff"
          }
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-google-signin/google-signin/app.plugin.js",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a6d49351-d62e-4890-b965-bae6d123e41b"
      }
    },
    "owner": "elisha.dev",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a6d49351-d62e-4890-b965-bae6d123e41b"
    }
  }
}
