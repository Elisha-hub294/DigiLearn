      "expo-status-bar",
      "expo-web-browser",
      "@react-native-google-signin/google-signin/app.plugin.js",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
