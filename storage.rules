rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.email_verified == true;
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.size < 20 * 1024 * 1024;
    }
  }
}